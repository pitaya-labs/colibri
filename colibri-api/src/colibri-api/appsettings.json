{
  "ConnectionStrings": {
    "Default": "Data Source=colibri_api.db"
  },
  "Jwt": {
    "Issuer": "colibri_api",
    "Audience": "colibri_api",
    "SigningKey": "dev-only-signing-key-override-with-user-secrets-or-env-vars"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
